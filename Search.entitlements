<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The hardened runtime refuses the camera and the microphone unless the
       app says up front that pages may ask for them. -->
  <key>com.apple.security.device.camera</key><true/>
  <key>com.apple.security.device.audio-input</key><true/>
  <!-- Likewise for a page asking where you are, which Search puts to you
       first, site by site (see Browser.askedForLocation). -->
  <key>com.apple.security.personal-information.location</key><true/>
  <!-- Google Chrome tabs (⌃⌘T) are opened, read and closed through Chrome's own
       scripting, which the hardened runtime refuses unless the app says so.
       macOS asks once whether Search may control Chrome (ChromeTabs.swift). -->
  <key>com.apple.security.automation.apple-events</key><true/>
</dict>
</plist>
